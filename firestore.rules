rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /games/{code} {
      // Anyone signed in can read a game by its (unguessable) code so they can join.
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.players == [request.auth.uid]
        && request.resource.data.moves.size() == 0
        && request.resource.data.status == 'waiting';

      // Joining: add yourself to the open seat.
      allow update: if request.auth != null
        && !(request.auth.uid in resource.data.players)
        && resource.data.players.size() == 1
        && request.resource.data.players.size() == 2
        && request.auth.uid in request.resource.data.players
        && request.resource.data.moves == resource.data.moves;

      // Players: append exactly one move on your own turn, or finish / offer a draw.
      allow update: if request.auth != null
        && request.auth.uid in resource.data.players
        && request.resource.data.players == resource.data.players
        && (
          request.resource.data.moves == resource.data.moves
          || (
            request.resource.data.moves.size() == resource.data.moves.size() + 1
            && request.resource.data.moves[0:resource.data.moves.size()] == resource.data.moves
            && request.auth.uid == (resource.data.moves.size() % 2 == 0
                 ? resource.data.whiteUid : resource.data.blackUid)
          )
        );
    }
  }
}
